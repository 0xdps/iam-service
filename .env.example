# IAM & Auth Platform - Environment Configuration Template
# Copy this file to .env and customize for your environment

# =============================================================================
# GLOBAL CONFIGURATION
# =============================================================================

# Environment (development, production, staging)
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# AUTH SERVICE CONFIGURATION (Go)
# =============================================================================

# Database Configuration
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=authdb
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=authpass
AUTH_DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-256-bits
JWT_EXPIRATION=300  # 5 minutes
REFRESH_TOKEN_EXPIRATION=604800  # 7 days

# Server Configuration
AUTH_SERVICE_PORT=8080
AUTH_SERVICE_HOST=0.0.0.0

# Security Configuration
ARGON2_MEMORY=65536     # 64MB
ARGON2_TIME=3           # 3 iterations
ARGON2_THREADS=2        # 2 threads
ARGON2_KEY_LENGTH=32    # 32 bytes

# MFA Configuration
MFA_ISSUER=IAM-Auth-Platform
MFA_WINDOW=1            # TOTP window tolerance

# Rate Limiting
AUTH_RATE_LIMIT=10      # requests per minute for auth endpoints
AUTH_RATE_WINDOW=60     # window in seconds

# =============================================================================
# IAM SERVICE CONFIGURATION (Node.js/TypeScript)
# =============================================================================

# Database Configuration
IAM_DB_HOST=localhost
IAM_DB_PORT=5433
IAM_DB_NAME=iamdb
IAM_DB_USER=iamuser
IAM_DB_PASSWORD=iampass
IAM_DB_SSL=false

# Server Configuration
IAM_SERVICE_PORT=3000
IAM_SERVICE_HOST=0.0.0.0

# External Service URLs
AUTH_SERVICE_URL=http://localhost:8080

# Cache Configuration
CACHE_TTL=300           # 5 minutes
CACHE_PREFIX=iam:

# Event Configuration
EVENT_STREAM_NAME=stream:iam.events
EVENT_CONSUMER_GROUP=iam-consumers

# API Configuration
API_RATE_LIMIT=100      # requests per minute
API_RATE_WINDOW=60      # window in seconds

# =============================================================================
# ADMIN FRONTEND CONFIGURATION (React)
# =============================================================================

# API URLs
REACT_APP_AUTH_API_URL=http://localhost:8080
REACT_APP_IAM_API_URL=http://localhost:3000

# Frontend Configuration
REACT_APP_NAME=IAM Admin Dashboard
REACT_APP_VERSION=1.0.0

# Theme Configuration
REACT_APP_THEME=light
REACT_APP_PRIMARY_COLOR=#1976d2

# Feature Flags
REACT_APP_ENABLE_MFA=true
REACT_APP_ENABLE_AUDIT_LOGS=true
REACT_APP_ENABLE_USER_REGISTRATION=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Auth Database
POSTGRES_AUTH_DB=authdb
POSTGRES_AUTH_USER=authuser
POSTGRES_AUTH_PASSWORD=authpass
POSTGRES_AUTH_PORT=5432

# PostgreSQL IAM Database
POSTGRES_IAM_DB=iamdb
POSTGRES_IAM_USER=iamuser
POSTGRES_IAM_PASSWORD=iampass
POSTGRES_IAM_PORT=5433

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# Session Configuration
SESSION_TTL=3600        # 1 hour
SESSION_PREFIX=sess:

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# Helmet Security Headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=true

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900        # 15 minutes
LOCKOUT_WINDOW=900      # 15 minutes

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Logging Configuration
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_CALLER=true

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Compose Override
COMPOSE_PROJECT_NAME=iam-service
COMPOSE_HTTP_TIMEOUT=120

# Image Configuration
AUTH_IMAGE_TAG=latest
IAM_IMAGE_TAG=latest
ADMIN_IMAGE_TAG=latest

# Resource Limits
AUTH_MEMORY_LIMIT=512m
IAM_MEMORY_LIMIT=512m
ADMIN_MEMORY_LIMIT=256m

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Tools
ENABLE_DEBUG=false
ENABLE_PROFILING=false
ENABLE_HOT_RELOAD=true

# Test Configuration
TEST_DB_NAME=testdb
TEST_REDIS_DB=1
TEST_LOG_LEVEL=error

# Mock Configuration
MOCK_EMAIL_SERVICE=true
MOCK_SMS_SERVICE=true
MOCK_EXTERNAL_APIS=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles for gradual rollout
FEATURE_USER_REGISTRATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_ACCOUNT_LOCKOUT=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_MFA_REQUIRED=false
FEATURE_SESSION_MANAGEMENT=true
FEATURE_ROLE_INHERITANCE=false

# =============================================================================
# PRODUCTION OVERRIDES (Uncomment for production)
# =============================================================================

# JWT_SECRET=generate-strong-256-bit-secret-key-for-production
# AUTH_DB_PASSWORD=strong-database-password
# IAM_DB_PASSWORD=another-strong-database-password
# REDIS_PASSWORD=redis-auth-password
# LOG_LEVEL=warn
# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com
{
  "name": "iam-service",
  "version": "1.0.0",
  "description": "IAM Service for User Management and Authorization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "npm run build && node dist/migrations/migrate.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.1",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "axios": "^1.4.0",
    "joi": "^17.9.2",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/pg": "^8.10.2",
    "@types/uuid": "^9.0.2",
    "@types/node": "^20.4.2",
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0"
  }
}